[Unit]
Description=FreeToken Qwen3.8 Flash Next NVFP4 262k
After=network-online.target nvidia-power-limit.service
Wants=network-online.target nvidia-power-limit.service

[Service]
Type=simple
User=obenomar
Group=obenomar
WorkingDirectory=/home/obenomar/.local/share/freetoken-flash-next-20260906
Environment=XDG_CACHE_HOME=/home/obenomar/localLLMinference/research/qwen3.8-flash-next-nvfp4-2026-09-06/cache
ExecStart=/home/obenomar/.local/share/freetoken-flash-next-20260906/.venv/bin/ft serve --model-path /home/obenomar/localLLMinference/models/qwen3.8-flash-next-nvfp4 --served-model-name qwen3.8-flash-next-nvfp4-262k --host 127.0.0.1 --port 1901 --gpu 0 --max-running-requests 1 --max-seq-len-override 262144 --num-tokens 262144 --max-output-tokens 8192 --max-prefill-length 512 --memory-ratio 0.97 --cuda-graph-max-bs 1 --cache-type radix --reasoning-parser qwen3 --moe-backend hybrid --nvfp4-backend triton --ple-backend disk --expert-load serial --moe-cache-size 2344 --moe-prefill-hit-d2d
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
LimitNOFILE=1048576
MemorySwapMax=0
TasksMax=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
