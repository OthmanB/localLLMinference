[Unit]
Description=Authenticated LAN OpenAI inference gateway
Wants=network-online.target
After=network-online.target freetoken-qwen3.8-flash-next-262k.service llama-qwen3.8-q4-192k.service
Requires=freetoken-qwen3.8-flash-next-262k.service llama-qwen3.8-q4-192k.service

[Service]
Type=simple
User=obenomar
Group=obenomar
EnvironmentFile=/etc/ai-server/lan-inference-gateway.env
WorkingDirectory=/home/obenomar/localLLMinference/lan-inference-gateway
ExecStart=/home/obenomar/localLLMinference/lan-inference-gateway/.venv/bin/lan-inference-gateway
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=5
SendSIGKILL=yes
LimitNOFILE=1048576
UMask=0077

[Install]
WantedBy=multi-user.target
