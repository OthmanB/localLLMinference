[Unit]
Description=Authenticated LAN OpenAI inference gateway
Wants=network-online.target
After=network-online.target llama-qwen3.8-q4-192k.service
Requires=llama-qwen3.8-q4-192k.service

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
EnvironmentFile=/etc/ai-server/lan-inference-gateway.env
WorkingDirectory=@REPO_ROOT@/lan-inference-gateway
ExecStart=@REPO_ROOT@/lan-inference-gateway/.venv/bin/lan-inference-gateway
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=5
SendSIGKILL=yes
LimitNOFILE=1048576
UMask=0077

[Install]
WantedBy=multi-user.target
