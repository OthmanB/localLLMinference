    {
      "title": "Gateway Pool Counters",
      "description": "Bounded gateway pool route, affinity, saturation, and cold-failover counters. Session IDs are never exported.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (pool, replica, reason) (rate(ai_gateway_pool_route_decisions_total[$__rate_interval]))",
          "legendFormat": "route {{pool}} {{replica}} {{reason}}"
        },
        {
          "expr": "sum by (pool, replica) (rate(ai_gateway_pool_affinity_hits_total[$__rate_interval]))",
          "legendFormat": "affinity hit {{pool}} {{replica}}"
        },
        {
          "expr": "sum by (pool, replica) (rate(ai_gateway_pool_affinity_misses_total[$__rate_interval]))",
          "legendFormat": "affinity miss {{pool}} {{replica}}"
        },
        {
          "expr": "sum by (pool, replica) (rate(ai_gateway_pool_saturation_rejections_total[$__rate_interval]))",
          "legendFormat": "saturation {{pool}} {{replica}}"
        },
        {
          "expr": "sum by (pool, replica) (rate(ai_gateway_pool_cold_failover_total[$__rate_interval]))",
          "legendFormat": "cold failover {{pool}} {{replica}}"
        }
